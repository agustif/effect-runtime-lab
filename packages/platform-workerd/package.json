{
  "name": "@effect-experimental/platform-workerd",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./unstable/*": "./src/unstable/*.ts",
    "./internal/*": null,
    "./*/index": null
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "check": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "types:generate": "node ./scripts/runtime-source.mjs generate",
    "types:check": "node ./scripts/runtime-source.mjs check"
  },
  "peerDependencies": {
    "effect": "workspace:^"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.13.1",
    "@cloudflare/workers-types": "4.20260317.1",
    "@effect/vitest": "workspace:*",
    "@types/node": "^25.2.0",
    "effect": "workspace:^",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.74.0"
  }
}
