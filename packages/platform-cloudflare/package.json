    "@effect-experimental/cloudflare-kv": "workspace:*",
    "@effect-experimental/platform-workerd": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  }
}
